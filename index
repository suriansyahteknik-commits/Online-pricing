            const totalHPP = subTotal + insurance + ppn + pph + cadangan;

            let marginPercent = margin;
            if (fleet.name.toLowerCase().includes('towing') || fleet.type === 'Special') {
                const limitTowing = costs.marginTowingDefault !== undefined ? costs.marginTowingDefault : 5;
                marginPercent = Math.max(limitTowing, customTowingMargin);
            }

            const marginVal = totalHPP * (marginPercent / 100);
            const hargaJual = totalHPP + marginVal;

            return { 
                bbmCost, 
                calculatedDriverFee, 
                returnTransportFee, 
                driverCost, 
                tollCost, 
                adminFee,
                loadingFee,
                unloadingFee,
                opsCost, 
                insurance, 
                ppn, 
                pph, 
                cadangan, 
                subTotal, 
                totalHPP, 
                marginVal, 
                hargaJual, 
                margin: marginPercent 
            };
        };

        const DashboardBI = ({ theme, quotations, routes, fleets, regions, customers, activities, onNavigate, loadData, isSyncing }) => {
            const [dateFilter, setDateFilter] = useState('All');
            const [customStartDate, setCustomStartDate] = useState('');
            const [customEndDate, setCustomEndDate] = useState('');
            const [filterCabang, setFilterCabang] = useState('');
            const [filterArmada, setFilterArmada] = useState('');
            const [filterCustomer, setFilterCustomer] = useState('');

            const targetRevenue = 50000000;
            const targetProfit = 12000000;
            const targetQuotations = 5;
            const targetCustomers = 8;

            const filteredQuotations = useMemo(() => {
                return quotations.filter(q => {
                    const qDate = new Date(q.date);
                    const now = new Date();
                    
                    if (dateFilter === 'Today') {
                        const todayStr = now.toISOString().split('T')[0];
                        if (q.date !== todayStr) return false;
                    } else if (dateFilter === 'Week') {
                        const oneWeekAgo = new Date();
                        oneWeekAgo.setDate(now.getDate() - 7);
                        if (qDate < oneWeekAgo) return false;
                    } else if (dateFilter === 'Month') {
                        const currentMonth = now.getMonth();
                        const currentYear = now.getFullYear();
                        if (qDate.getMonth() !== currentMonth || qDate.getFullYear() !== currentYear) return false;
                    } else if (dateFilter === 'Year') {
                        if (qDate.getFullYear() !== now.getFullYear()) return false;
                    } else if (dateFilter === 'Custom' && customStartDate && customEndDate) {
                        const start = new Date(customStartDate);
                        const end = new Date(customEndDate);
                        if (qDate < start || qDate > end) return false;
                    }

                    if (filterCabang && !q.route.toLowerCase().includes(filterCabang.toLowerCase())) return false;
                    if (filterArmada && q.fleet !== filterArmada) return false;
                    if (filterCustomer && q.client !== filterCustomer) return false;

                    return true;
                });
            }, [quotations, dateFilter, customStartDate, customEndDate, filterCabang, filterArmada, filterCustomer]);

            const chart1Ref = useRef(null);
            const chart2Ref = useRef(null);
            const chart3Ref = useRef(null);
            const chart4Ref = useRef(null);
            const chart5Ref = useRef(null);
            const chart6Ref = useRef(null);

            const chartInstances = useRef({});

            const kpis = useMemo(() => {
                const totalQ = filteredQuotations.length;
                let revenue = 0;
                let hpp = 0;
                let profit = 0;
                let sumMarginPercent = 0;
                const distinctCusts = new Set();
                
                filteredQuotations.forEach(q => {
                    revenue += q.sellPrice || 0;
                    hpp += q.hpp || 0;
                    profit += ((q.sellPrice || 0) - (q.hpp || 0));
                    sumMarginPercent += q.margin || 0;
                    distinctCusts.add(q.client);
                });

                const averageMargin = totalQ > 0 ? (sumMarginPercent / totalQ) : 0;
                return {
                    totalQuotations: totalQ,
                    totalRevenue: revenue,
                    totalHPP: hpp,
                    totalProfit: profit,
                    averageMargin: averageMargin,
                    totalCustomers: distinctCusts.size,
                    totalRoutes: routes.length,
                    totalFleets: fleets.length,
                    totalRegions: regions.length
                };
            }, [filteredQuotations, routes, fleets, regions]);

            const opBreakdown = useMemo(() => {
                let totalKM = 0;
                let totalBBM = 0;
                let totalDriver = 0;
                let totalTol = 0;
                let totalOps = 0;
                let totalTax = 0;

                filteredQuotations.forEach(q => {
                    totalKM += q.distanceKm || 0;
                    totalBBM += q.bbmCost || 0;
                    totalDriver += q.driverCost || 0;
                    totalTol += q.tollCost || 0;
                    totalOps += q.opsCost || 0;
                    totalTax += (q.ppn || 0) + (q.pph || 0);
                });

                return { totalKM, totalBBM, totalDriver, totalTol, totalOps, totalTax };
            }, [filteredQuotations]);

            const topCustomers = useMemo(() => {
                const map = {};
                filteredQuotations.forEach(q => {
                    map[q.client] = (map[q.client] || 0) + q.sellPrice;
                });
                return Object.entries(map)
                    .map(([name, value]) => ({ name, value }))
                    .sort((a, b) => b.value - a.value)
                    .slice(0, 5);
            }, [filteredQuotations]);

            const topRoutes = useMemo(() => {
                const map = {};
                filteredQuotations.forEach(q => {
                    map[q.route] = (map[q.route] || 0) + 1;
                });
                return Object.entries(map)
                    .map(([route, count]) => ({ route, count }))
                    .sort((a, b) => b.count - a.count)
                    .slice(0, 5);
            }, [filteredQuotations]);

            const marginPerArmada = useMemo(() => {
                const map = {};
                filteredQuotations.forEach(q => {
                    if (!map[q.fleet]) {
                        map[q.fleet] = { sumMargin: 0, count: 0 };
                    }
                    map[q.fleet].sumMargin += q.margin;
                    map[q.fleet].count += 1;
                });
                return Object.entries(map)
                    .map(([fleet, info]) => ({ fleet, avgMargin: info.sumMargin / info.count }))
                    .sort((a, b) => b.avgMargin - a.avgMargin);
            }, [filteredQuotations]);

            useEffect(() => {
                const isDark = theme === 'dark';
                const textCol = isDark ? '#94a3b8' : '#64748b';
                const gridCol = isDark ? '#1e293b' : '#f1f5f9';

                const draw = (key, ref, config) => {
                    if (chartInstances.current[key]) {
                        chartInstances.current[key].destroy();
                    }
                    if (ref.current) {
                        chartInstances.current[key] = new Chart(ref.current.getContext('2d'), config);
                    }
                };

                const months = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'];
                const monthlyRevenue = {};
                const monthlyHPP = {};
                
                filteredQuotations.forEach(q => {
                    const m = new Date(q.date).getMonth();
                    monthlyRevenue[m] = (monthlyRevenue[m] || 0) + q.sellPrice;
                    monthlyHPP[m] = (monthlyHPP[m] || 0) + q.hpp;
                });

                const lineDataRev = months.map((_, i) => monthlyRevenue[i] || 0);
                const lineDataHPP = months.map((_, i) => monthlyHPP[i] || 0);
                const lineDataProfit = lineDataRev.map((rev, i) => rev - lineDataHPP[i]);

                draw('revVsHpp', chart1Ref, {
                    type: 'line',
                    data: {
                        labels: months,
                        datasets: [
                            { label: 'Revenue', data: lineDataRev, borderColor: '#ea580c', backgroundColor: 'rgba(234, 88, 12, 0.1)', fill: true, tension: 0.3 },
                            { label: 'HPP', data: lineDataHPP, borderColor: '#3b82f6', backgroundColor: 'transparent', borderDash: [4, 4], tension: 0.3 },
                            { label: 'Profit', data: lineDataProfit, borderColor: '#10b981', backgroundColor: 'transparent', tension: 0.3 }
                        ]
                    },
                    options: {
                        responsive: true, maintainAspectRatio: false,
                        plugins: { legend: { labels: { color: textCol } } },
                        scales: { y: { grid: { color: gridCol }, ticks: { color: textCol } }, x: { ticks: { color: textCol } } }
                    }
                });

                const qMonthlyCount = {};
                filteredQuotations.forEach(q => {
                    const m = new Date(q.date).getMonth();
                    qMonthlyCount[m] = (qMonthlyCount[m] || 0) + 1;
                });
                const barDataCount = months.map((_, i) => qMonthlyCount[i] || 0);

                draw('qMonth', chart2Ref, {
                    type: 'bar',
                    data: {
                        labels: months,
                        datasets: [{ label: 'Jumlah Quotation', data: barDataCount, backgroundColor: '#f97316', borderRadius: 4 }]
                    },
                    options: {
                        responsive: true, maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: { y: { grid: { color: gridCol }, ticks: { color: textCol, stepSize: 1 } }, x: { ticks: { color: textCol } } }
                    }
                });

                draw('marginFleet', chart3Ref, {
                    type: 'bar',
                    data: {
                        labels: marginPerArmada.map(m => m.fleet),
                        datasets: [{ label: 'Rata-rata Margin (%)', data: marginPerArmada.map(m => m.avgMargin), backgroundColor: '#10b981', borderRadius: 4 }]
                    },
                    options: {
                        responsive: true, maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: { y: { grid: { color: gridCol }, ticks: { color: textCol } }, x: { ticks: { color: textCol } } }
                    }
                });

                draw('costBreakdown', chart4Ref, {
                    type: 'doughnut',
                    data: {
                        labels: ['BBM', 'Driver', 'Tol', 'Operasional', 'Pajak'],
                        datasets: [{
                            data: [opBreakdown.totalBBM, opBreakdown.totalDriver, opBreakdown.totalTol, opBreakdown.totalOps, opBreakdown.totalTax],
                            backgroundColor: ['#f97316', '#3b82f6', '#10b981', '#a855f7', '#64748b']
                        }]
                    },
                    options: {
                        responsive: true, maintainAspectRatio: false,
                        plugins: { legend: { position: 'right', labels: { color: textCol } } }
                    }
                });

                draw('topRoutes', chart5Ref, {
                    type: 'bar',
                    data: {
                        labels: topRoutes.map(r => r.route.split(' - ')[1] || r.route),
                        datasets: [{ label: 'Penggunaan Rute', data: topRoutes.map(r => r.count), backgroundColor: '#a855f7', borderRadius: 4 }]
                    },
                    options: {
                        indexAxis: 'y',
                        responsive: true, maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: { x: { grid: { color: gridCol }, ticks: { color: textCol, stepSize: 1 } }, y: { ticks: { color: textCol } } }
                    }
                });

                draw('topCust', chart6Ref, {
                    type: 'bar',
                    data: {
                        labels: topCustomers.map(c => c.name.length > 15 ? c.name.substr(0, 15) + '...' : c.name),
                        datasets: [{ label: 'Nilai Quotation (IDR)', data: topCustomers.map(c => c.value), backgroundColor: '#3b82f6', borderRadius: 4 }]
                    },
                    options: {
                        indexAxis: 'y',
                        responsive: true, maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: { x: { grid: { color: gridCol }, ticks: { color: textCol } }, y: { ticks: { color: textCol } } }
                    }
                });

                return () => {
                    Object.values(chartInstances.current).forEach(chart => chart.destroy());
                };
            }, [filteredQuotations, theme, marginPerArmada, opBreakdown, topCustomers, topRoutes]);

            const handlePrint = () => { window.print(); };

            const handleExportExcel = () => {
                const sheetData = filteredQuotations.map(q => ({
                    'ID Dokumen': q.id,
                    'Klien / Customer': q.client,
                    'Tanggal': q.date,
                    'Rute Perjalanan': q.route,
                    'Jenis Armada': q.fleet,
                    'Jarak (KM)': q.distanceKm || 0,
                    'Biaya BBM': q.bbmCost || 0,
                    'Biaya Driver Utama': q.calculatedDriverFee || 0,
                    'Biaya Transport Balik': q.returnTransportFee || 0,
                    'Biaya Tol': q.tollCost || 0,
                    'Biaya Ops': q.opsCost || 0,
                    'HPP (IDR)': q.hpp,
                    'Harga Jual (IDR)': q.sellPrice,
                    'Margin (%)': q.margin,
                    'Status': q.status
                }));
                const ws = XLSX.utils.json_to_sheet(sheetData);
                const wb = XLSX.utils.book_new();
                XLSX.utils.book_append_sheet(wb, ws, "Dashboard Data");
                XLSX.writeFile(wb, "WHOOSH_EXPRESS_BI_Dashboard_Report.xlsx");
            };

            const insights = useMemo(() => {
                const list = [];
                if (kpis.totalRevenue > 0) {
                    list.push(`Total revenue saat ini mencapai ${formatCurrency(kpis.totalRevenue)} dengan profit bersih ${formatCurrency(kpis.totalProfit)}.`);
                }
                if (kpis.averageMargin < 15) {
                    list.push(`⚠️ WARNING: Rata-rata margin di bawah target dasar perusahaan (${kpis.averageMargin.toFixed(1)}%). Segera evaluasi harga dasar!`);
                } else {
                    list.push(`Rata-rata profit margin terjaga aman pada level optimal ${kpis.averageMargin.toFixed(1)}%.`);
                }
                if (topRoutes.length > 0) {
                    list.push(`Rute terfavorit saat ini didominasi oleh rute: "${topRoutes[0]?.route}" sebanyak ${topRoutes[0]?.count} kali pengiriman.`);
                }
                if (marginPerArmada.length > 0) {
                    list.push(`Armada paling menguntungkan secara persentase adalah tipe: "${marginPerArmada[0]?.fleet}".`);
                }
                return list;
            }, [kpis, topRoutes, marginPerArmada]);

            return (
                <div className="space-y-6 animate-slide-up print-full relative z-10">
                    <div className="flex flex-col md:flex-row md:items-center justify-between gap-4 no-print border-b border-slate-200 dark:border-slate-800 pb-5">
                        <div className="text-left">
                            <h2 className="text-2xl font-black tracking-tight text-slate-900 dark:text-white uppercase flex items-center">
                                <i className="fa-solid fa-chart-line text-brand-500 mr-3 animate-pulse"></i> Business Intelligence Dashboard
                            </h2>
                            <p className="text-sm text-slate-500 dark:text-slate-400">Analisis metrik performa komersial Whoosh Express secara real-time.</p>
                        </div>
                        <div className="flex flex-wrap gap-2">
                            <Button variant="outline" icon={isSyncing ? "fa-spinner fa-spin" : "fa-arrows-rotate"} onClick={() => loadData(true)} disabled={isSyncing}>
                                Sync Awan
                            </Button>
                            <Button variant="outline" icon="fa-plus" onClick={() => onNavigate('simulasi')}>Quotation Baru</Button>
                            <Button variant="outline" icon="fa-file-excel" onClick={handleExportExcel}>Export Excel</Button>
                            <Button variant="outline" icon="fa-print" onClick={handlePrint}>Print Dashboard</Button>
                        </div>
                    </div>

                    <div className="grid grid-cols-1 gap-4 text-left">
                        {kpis.averageMargin < 15 && (
                            <div className="bg-red-50 dark:bg-red-950/20 border border-red-200 dark:border-red-900 text-red-800 dark:text-red-300 rounded-xl p-4 flex items-start space-x-3 shadow-sm animate-pulse-slow">
                                <i className="fa-solid fa-triangle-exclamation text-xl mt-0.5 text-red-500"></i>
                                <div>
                                    <h4 className="font-bold text-sm">Critical Margin Threshold Warning</h4>
                                    <p className="text-xs text-red-600 dark:text-red-400 mt-1 font-medium">Rata-rata keuntungan margin operasional yang di-filter berada di bawah level aman perusahaan (&lt;15%). Pastikan untuk melakukan review harga dasar armada atau menyesuaikan penawaran komersial Anda.</p>
                                </div>
                            </div>
                        )}
                    </div>

                    <Card className="p-4 bg-slate-50/50 dark:bg-slate-900/40 border border-slate-200 dark:border-slate-800 no-print">
                        <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 text-left">
                            <div>
                                <Select label="Periode Tanggal" value={dateFilter} onChange={e=>setDateFilter(e.target.value)} options={[
                                    { value: 'All', label: 'Semua Periode' },
                                    { value: 'Today', label: 'Hari Ini' },
                                    { value: 'Week', label: 'Minggu Ini' },
                                    { value: 'Month', label: 'Bulan Ini' },
                                    { value: 'Year', label: 'Tahun Ini' },
                                    { value: 'Custom', label: 'Kustom Tanggal' },
                                ]} />
                            </div>
                            
                            {dateFilter === 'Custom' && (
                                <div className="col-span-1 sm:col-span-2 grid grid-cols-2 gap-2 animate-fade-in text-left">
                                    <Input label="Dari" type="date" value={customStartDate} onChange={e=>setCustomStartDate(e.target.value)} />
                                    <Input label="Sampai" type="date" value={customEndDate} onChange={e=>setCustomEndDate(e.target.value)} />
                                </div>
                            )}

                            <div>
                                <Select label="Cabang/Wilayah" value={filterCabang} onChange={e=>setFilterCabang(e.target.value)} options={
                                    regions.map(r => ({ value: r.city, label: r.city }))
                                } />
                            </div>
                            <div>
                                <Select label="Armada" value={filterArmada} onChange={e=>setFilterArmada(e.target.value)} options={
                                    fleets.map(f => ({ value: f.name, label: f.name }))
                                } />
                            </div>
                            <div>
                                <Select label="Klien/Customer" value={filterCustomer} onChange={e=>setFilterCustomer(e.target.value)} options={
                                    customers.map(c => ({ value: c.name, label: c.name }))
                                } />
                            </div>
                        </div>
                    </Card>

                    <div className="grid grid-cols-1 lg:grid-cols-4 gap-4 no-print text-left">
                        <Card className="p-4 flex flex-col justify-between">
                            <div className="flex justify-between text-xs text-slate-500 font-bold mb-2">
                                <span>TARGET REVENUE</span>
                                <span>{Math.min(100, Math.round((kpis.totalRevenue/targetRevenue)*100))}%</span>
                            </div>
                            <div className="text-lg font-black">{formatCurrency(kpis.totalRevenue)} / {formatCurrency(targetRevenue)}</div>
                            <div className="w-full bg-slate-200 dark:bg-slate-800 h-2 rounded-full mt-3 overflow-hidden">
                                <div className="bg-brand-500 h-full rounded-full transition-all duration-500" style={{ width: `${Math.min(100, (kpis.totalRevenue/targetRevenue)*100)}%` }}></div>
                            </div>
                        </Card>
                        <Card className="p-4 flex flex-col justify-between">
                            <div className="flex justify-between text-xs text-slate-500 font-bold mb-2">
                                <span>TARGET NET PROFIT</span>
                                <span>{Math.min(100, Math.round((kpis.totalProfit/targetProfit)*100))}%</span>
                            </div>
                            <div className="text-lg font-black">{formatCurrency(kpis.totalProfit)} / {formatCurrency(targetProfit)}</div>
                            <div className="w-full bg-slate-200 dark:bg-slate-800 h-2 rounded-full mt-3 overflow-hidden">
                                <div className="bg-emerald-500 h-full rounded-full transition-all duration-500" style={{ width: `${Math.min(100, (kpis.totalProfit/targetProfit)*100)}%` }}></div>
                            </div>
                        </Card>
                        <Card className="p-4 flex flex-col justify-between">
                            <div className="flex justify-between text-xs text-slate-500 font-bold mb-2">
                                <span>TARGET QUOTATIONS</span>
                                <span>{Math.min(100, Math.round((kpis.totalQuotations/targetQuotations)*100))}%</span>
                            </div>
                            <div className="text-lg font-black">{kpis.totalQuotations} / {targetQuotations}</div>
                            <div className="w-full bg-slate-200 dark:bg-slate-800 h-2 rounded-full mt-3 overflow-hidden">
                                <div className="bg-blue-500 h-full rounded-full transition-all duration-500" style={{ width: `${Math.min(100, (kpis.totalQuotations/targetQuotations)*100)}%` }}></div>
                            </div>
                        </Card>
                        <Card className="p-4 flex flex-col justify-between">
                            <div className="flex justify-between text-xs text-slate-500 font-bold mb-2">
                                <span>ACTIVE CUSTOMERS</span>
                                <span>{Math.min(100, Math.round((kpis.totalCustomers/targetCustomers)*100))}%</span>
                            </div>
                            <div className="text-lg font-black">{kpis.totalCustomers} / {targetCustomers}</div>
                            <div className="w-full bg-slate-200 dark:bg-slate-800 h-2 rounded-full mt-3 overflow-hidden">
                                <div className="bg-purple-500 h-full rounded-full transition-all duration-500" style={{ width: `${Math.min(100, (kpis.totalCustomers/targetCustomers)*100)}%` }}></div>
                            </div>
                        </Card>
                    </div>

                    <div className="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 text-left">
                        {[
                            { title: 'Total Penawaran', val: kpis.totalQuotations, icon: 'fa-file-invoice-dollar', color: 'text-brand-500', bg: 'bg-brand-5:10' },
                            { title: 'Est. Revenue', val: formatCurrency(kpis.totalRevenue), icon: 'fa-chart-line', color: 'text-emerald-500', bg: 'bg-emerald-5:10' },
                            { title: 'Total HPP', val: formatCurrency(kpis.totalHPP), icon: 'fa-tags', color: 'text-blue-500', bg: 'bg-blue-5:10' },
                            { title: 'Total Profit', val: formatCurrency(kpis.totalProfit), icon: 'fa-money-bill-wave', color: 'text-amber-500', bg: 'bg-amber-5:10' },
                        ].map((card, i) => (
                            <Card key={i} className="p-4 flex items-center justify-between border-l-4 border-l-brand-500">
                                <div>
                                    <p className="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">{card.title}</p>
                                    <h4 className="text-base sm:text-lg font-black text-slate-900 dark:text-white mt-1">{card.val}</h4>
                                </div>
                                <div className={`p-2.5 rounded-lg text-brand-500 bg-brand-50 dark:bg-brand-500/10`}>
                                    <i className={`fa-solid ${card.icon} text-lg`}></i>
                                </div>
                            </Card>
                        ))}
                    </div>

                    <div className="grid grid-cols-1 lg:grid-cols-2 gap-6 text-left">
                        <Card className="p-5 border-t-4 border-t-blue-500">
                            <h3 className="text-sm font-bold uppercase tracking-wider text-slate-900 dark:text-white mb-4 flex items-center">
                                <i className="fa-solid fa-gears text-blue-500 mr-2"></i> Operational Breakdown
                            </h3>
                            <div className="space-y-3.5">
                                {[
                                    { label: 'Total Jarak Distribusi', val: `${formatNumber(opBreakdown.totalKM)} KM`, icon: 'fa-road' },
                                    { label: 'Total Biaya BBM', val: formatCurrency(opBreakdown.totalBBM), icon: 'fa-gas-pump' },
                                    { label: 'Total Biaya Driver (Utama + Balik)', val: formatCurrency(opBreakdown.totalDriver), icon: 'fa-id-card' },
                                    { label: 'Total Biaya Tol', val: formatCurrency(opBreakdown.totalTol), icon: 'fa-road-barrier' },
                                    { label: 'Total Pajak & Retribusi', val: formatCurrency(opBreakdown.totalTax), icon: 'fa-percent' },
                                ].map((item, i) => (
                                    <div key={i} className="flex justify-between items-center py-2 border-b border-slate-100 dark:border-slate-800 last:border-0">
                                        <span className="text-sm text-slate-600 dark:text-slate-400 flex items-center">
                                            <i className={`fa-solid ${item.icon} mr-3 text-slate-400`}></i> {item.label}
                                        </span>
                                        <span className="text-sm font-black text-slate-900 dark:text-white">{item.val}</span>
                                    </div>
                                ))}
                            </div>
                        </Card>

                        <Card className="p-5 border-t-4 border-t-purple-500">
                            <h3 className="text-sm font-bold uppercase tracking-wider text-slate-900 dark:text-white mb-4 flex items-center">
                                <i className="fa-solid fa-robot text-purple-500 mr-2 animate-pulse"></i> Automated BI Insights
                            </h3>
                            {insights.length === 0 ? (
                                <p className="text-sm text-slate-500">Tidak ada insight yang cukup tersedia untuk filter data terpilih.</p>
                            ) : (
                                <ul className="space-y-3">
