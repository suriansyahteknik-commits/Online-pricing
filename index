                            <img src="MASTER PNG LOGO WHOOSH EXPRESS .png" alt="Watermark" className="w-[300px] sm:w-[500px] md:w-[700px] h-auto object-contain select-none" onError={(e)=>{e.target.style.display='none';}} />
                        </div>

                        <header className="h-16 glass sticky top-0 z-10 border-b border-slate-200 dark:border-slate-800/50 flex items-center justify-between px-4 sm:px-8 no-print shrink-0">
                            <div className="flex items-center">
                                {window.innerWidth >= 1024 && (
                                    <button onClick={() => setIsSidebarOpen(!isSidebarOpen)} className="mr-4 text-slate-500 hover:text-brand-500 transition-colors">
                                        <i className={`fa-solid ${isSidebarOpen ? 'fa-bars-staggered' : 'fa-bars'} text-xl`}></i>
                                    </button>
                                )}
                                {window.innerWidth < 1024 && (
                                    <button onClick={() => setIsSidebarOpen(true)} className="mr-4 text-slate-500 hover:text-brand-500 transition-colors">
                                        <i className="fa-solid fa-bars text-xl"></i>
                                    </button>
                                )}
                                <h1 className="text-lg font-bold text-slate-800 dark:text-white hidden sm:block">National Corporate Pricing Engine</h1>
                            </div>
                            <div className="flex items-center space-x-2 sm:space-x-4">
                                <button onClick={() => loadData(true)} disabled={isSyncing} title="Sinkronisasi Awan Manual" className="w-10 h-10 rounded-full flex items-center justify-center text-slate-500 hover:bg-slate-200 dark:hover:bg-slate-800 transition-colors disabled:opacity-50">
                                    <i className={`fa-solid fa-arrows-rotate text-lg ${isSyncing ? 'animate-spin text-brand-500' : ''}`}></i>
                                </button>
                                <button onClick={() => setTheme(theme === 'light' ? 'dark' : 'light')} className="w-10 h-10 rounded-full flex items-center justify-center text-slate-500 hover:bg-slate-200 dark:hover:bg-slate-800 transition-colors">
                                    <i className={`fa-solid ${theme === 'light' ? 'fa-moon' : 'fa-sun text-amber-400'} text-lg`}></i>
                                </button>
                                <button className="w-10 h-10 rounded-full flex items-center justify-center text-slate-500 hover:bg-slate-200 dark:hover:bg-slate-800 transition-colors relative">
                                    <i className="fa-solid fa-bell text-lg"></i>
                                    <span className="absolute top-2 right-2 w-2 h-2 bg-red-500 rounded-full border border-white dark:border-slate-900 animate-pulse"></span>
                                </button>
                            </div>
                        </header>
                        
                        <main className="flex-1 overflow-y-auto p-4 sm:p-8 relative z-10">
                            <div className="max-w-7xl mx-auto">
                                {renderContent()}
                            </div>
                        </main>
                    </div>
                </div>
            );
        };

        const AuthScreen = ({ onLoginSuccess }) => {
            const [isRegister, setIsRegister] = useState(false);
            const [email, setEmail] = useState('admin@whooshexpress.com');
            const [password, setPassword] = useState('Whoosh@2026');
            const [companyName, setCompanyName] = useState('');
            const [loading, setLoading] = useState(false);
            const [errorMsg, setErrorMsg] = useState('');
            const [showFirebaseHelp, setShowFirebaseHelp] = useState(false);
            const toast = useToast();

            const handleAuth = async (e) => {
                if (e) e.preventDefault();

                // Always-available local administrator account for this standalone demo.
                // It intentionally bypasses optional Firebase so the app remains usable offline.
                if (email.trim().toLowerCase() === 'admin@whooshexpress.com' && password === 'Whoosh@2026') {
                    window.localStorage.setItem('we_last_login_v2', JSON.stringify({ email: 'admin@whooshexpress.com', at: new Date().toISOString() }));
                    toast("Selamat datang, Administrator Whoosh Express!");
                    onLoginSuccess({ uid: 'ADMIN-WHOOSH-LOCAL', email: 'admin@whooshexpress.com', displayName: 'Whoosh Administrator' });
                    return;
                }
                
                // Validasi modus offline jika firebase tidak aktif / tidak terdeteksi
                if (!window.FBApi || !window.firebaseActive) {
                    if (email === 'admin@whooshexpress.com' && password === 'Whoosh@2026') {
                        toast("Masuk via Sandbox Offline Whoosh Express!");
                        onLoginSuccess({ 
                            uid: 'ADMIN-WHOOSH-OFFLINE', 
                            email: 'admin@whooshexpress.com', 
                            displayName: 'Whoosh Admin (Offline)' 
                        });
                    } else {
                        setErrorMsg("Kredensial offline tidak valid. Gunakan email & sandi resmi.");
                        toast("Kredensial offline salah!", "error");
                    }
                    return;
                }

                setLoading(true);
                setErrorMsg('');
                setShowFirebaseHelp(false);
                const { auth, signInWithEmailAndPassword, createUserWithEmailAndPassword } = window.FBApi;

                try {
                    if (isRegister) {
                        const userCredential = await createUserWithEmailAndPassword(auth, email, password);
                        toast("Registrasi Akun Korporasi Berhasil!");
                        onLoginSuccess(userCredential.user);
                    } else {
                        try {
                            const userCredential = await signInWithEmailAndPassword(auth, email, password);
                            toast("Selamat datang kembali!");
                            onLoginSuccess(userCredential.user);
                        } catch (loginError) {
                            if (
                                loginError.code === 'auth/user-not-found' || 
                                loginError.code === 'auth/invalid-credential' || 
                                loginError.code === 'auth/wrong-password'
                            ) {
                                try {
                                    const userCredential = await createUserWithEmailAndPassword(auth, email, password);
                                    toast("Akun admin berhasil diregistrasikan di database awan!");
                                    onLoginSuccess(userCredential.user);
                                } catch (regError) {
                                    if (regError.code === 'auth/operation-not-allowed') {
                                        setShowFirebaseHelp(true);
                                        throw new Error("Metode login Email/Password dinonaktifkan di konsol Firebase Anda.");
                                    } else {
                                        throw loginError; 
                                    }
                                }
                            } else {
                                throw loginError;
                            }
                        }
                    }
                } catch (error) {
                    console.error("Authentication Error: ", error);
                    let cleanMsg = "Gagal memproses autentikasi. Pastikan email dan sandi benar.";
                    if (error.code === 'auth/email-already-in-use') cleanMsg = "Email ini sudah terdaftar di sistem Whoosh.";
                    if (error.code === 'auth/weak-password') cleanMsg = "Sandi terlalu lemah (minimal 6 karakter).";
                    if (error.code === 'auth/user-not-found' || error.code === 'auth/wrong-password' || error.code === 'auth/invalid-credential') {
                        cleanMsg = "Kredensial login tidak valid untuk server awan.";
                    }
                    if (error.message && error.message.includes("Email/Password dinonaktifkan")) {
                        cleanMsg = error.message;
                    }
                    setErrorMsg(cleanMsg);
                } finally {
                    setLoading(false);
                }
            };

            const handleGuestAccess = async () => {
                setLoading(true);
                setErrorMsg('');
                try {
                    if (window.FBApi && window.firebaseActive) {
                        const { auth, signInAnonymously } = window.FBApi;
                        const userCredential = await signInAnonymously(auth);
                        toast("Masuk sebagai tamu (Guest Mode) berhasil.");
                        onLoginSuccess(userCredential.user);
                    } else {
                        toast("Akses sandbox offline diaktifkan.");
                        onLoginSuccess({ uid: 'OFFLINE-GUEST', email: 'guest@whooshexpress.local', displayName: 'Tamu Logistik Offline' });
                    }
                } catch(e) {
                    setErrorMsg("Gagal login anonim. Mengaktifkan sandbox.");
                    onLoginSuccess({ uid: 'OFFLINE-GUEST', email: 'guest@whooshexpress.local' });
                } finally {
                    setLoading(false);
                }
            };

            return (
                <div className="min-h-screen flex items-center justify-center bg-slate-950 p-4 relative overflow-hidden">
                    <div className="absolute inset-0 bg-cover bg-center opacity-10 select-none pointer-events-none" style={{ backgroundImage: "url('MASTER PNG LOGO WHOOSH EXPRESS .png')", backgroundSize: '70%', backgroundPosition: 'center', backgroundRepeat: 'no-repeat' }}></div>
                    <div className="absolute top-10 left-10 w-72 h-72 bg-brand-500/10 rounded-full blur-3xl"></div>
                    <div className="absolute bottom-10 right-10 w-96 h-96 bg-blue-500/10 rounded-full blur-3xl"></div>

                    <div className="relative z-10 w-full max-w-md bg-slate-900/80 backdrop-blur-xl border border-slate-800 rounded-2xl p-8 shadow-2xl text-left">
                        <div className="flex flex-col items-center justify-center mb-8">
                            <img src="MASTER PNG LOGO WHOOSH EXPRESS .png" alt="Whoosh Express Logo" className="h-16 w-auto object-contain mb-4" onError={(e)=>{e.target.src='https://placehold.co/180x60/f97316/ffffff?text=WHOOSH';}} />
                            <h2 className="text-xl font-black tracking-tight text-white uppercase">Corporate Pricing Engine</h2>
                            <p className="text-xs text-slate-400 mt-1">Sistem Perhitungan HPP & BI Logistik Nasional</p>
                        </div>

                        {errorMsg && (
                            <div className="mb-4 p-3 bg-red-950/40 border border-red-900/60 text-red-400 rounded-lg text-xs font-semibold flex flex-col space-y-1">
                                <div className="flex items-start space-x-2">
                                    <i className="fa-solid fa-circle-exclamation mt-0.5"></i>
                                    <span>{errorMsg}</span>
                                </div>
                                {showFirebaseHelp && (
                                    <div className="mt-2 p-2 bg-slate-950/80 text-slate-300 rounded text-[11px] font-normal leading-relaxed space-y-1">
                                        <p className="font-bold text-amber-400"><i className="fa-solid fa-wrench"></i> Cara Mengaktifkan di Firebase Console:</p>
                                        <p>1. Buka <b>Firebase Console</b> proyek Anda.</p>
                                        <p>2. Pilih menu <b>Authentication</b> di bilah kiri.</p>
                                        <p>3. Masuk ke tab <b>Sign-in method</b>.</p>
                                        <p>4. Klik <b>Add new provider</b>, lalu pilih <b>Email/Password</b>.</p>
                                        <p>5. Klik toggle <b>Enable</b> lalu klik <b>Save</b>.</p>
                                    </div>
                                )}
                            </div>
                        )}

                        <form onSubmit={handleAuth} className="space-y-4">
                            <div className="rounded-lg border border-brand-500/30 bg-brand-500/10 px-3 py-2 text-[11px] text-brand-100 leading-relaxed">
                                <b className="text-brand-300">Akun Administrator Demo</b><br />
                                Email: <b>admin@whooshexpress.com</b><br />
                                Kata sandi: <b>Whoosh@2026</b>
                            </div>
                            {isRegister && (
                                <Input label="Nama Perusahaan / Korporasi" placeholder="Contoh: PT Logistics Services" value={companyName} onChange={e=>setCompanyName(e.target.value)} required />
                            )}
                            <Input label="Email Korporat" type="email" placeholder="nama@perusahaan.co.id" value={email} onChange={e=>setEmail(e.target.value)} required />
                            <Input label="Kata Sandi" type="password" placeholder="Minimal 6 karakter" value={password} onChange={e=>setPassword(e.target.value)} required />

                            <Button type="submit" className="w-full py-3 text-base font-bold" disabled={loading}>
                                {loading ? <i className="fa-solid fa-spinner animate-spin mr-2"></i> : null}
                                {isRegister ? "Daftar Akun Baru" : "Masuk Logistik"}
                            </Button>
                        </form>

                        <div className="relative flex py-4 items-center">
                            <div className="flex-grow border-t border-slate-800"></div>
                            <span className="flex-shrink mx-4 text-slate-500 text-xs uppercase tracking-wider font-semibold">Atau</span>
                            <div className="flex-grow border-t border-slate-800"></div>
                        </div>

                        <div className="space-y-3">
                            <button onClick={handleGuestAccess} type="button" className="w-full flex items-center justify-center px-4 py-2.5 rounded-lg border border-slate-700 bg-transparent text-slate-300 hover:bg-slate-800/50 text-sm font-semibold transition-all">
                                <i className="fa-solid fa-user-secret mr-2"></i> Masuk Tanpa Akun (Guest Mode)
                            </button>

                            <button onClick={() => setIsRegister(!isRegister)} type="button" className="w-full text-center text-xs text-brand-500 font-bold hover:underline">
                                {isRegister ? "Sudah memiliki akun? Masuk di sini" : "Belum punya akun? Registrasi Korporasi"}
                            </button>
                        </div>
                    </div>
                </div>
            );
        };

        const MainAppContainer = () => {
            const [user, setUser] = useState(null);
            const [initializing, setInitializing] = useState(true);
            const toast = useToast();

            useEffect(() => {
                const interval = setInterval(() => {
                    if (window.FBApi) {
                        clearInterval(interval);
                        const { auth, onAuthStateChanged, signInWithCustomToken } = window.FBApi;
                        
                        onAuthStateChanged(auth, async (currentUser) => {
                            if (currentUser) {
                                setUser(currentUser);
                                setInitializing(false);
                            } else {
                                const token = typeof __initial_auth_token !== 'undefined' ? __initial_auth_token : null;
                                if (token) {
                                    try {
                                        const userCredential = await signInWithCustomToken(auth, token);
                                        setUser(userCredential.user);
                                    } catch(e) {
                                        console.warn("Custom token auth failed. Waiting for manual login.", e);
                                    }
                                }
                                setInitializing(false);
                            }
                        });
                    }
                }, 100);

                const fallbackTimeout = setTimeout(() => {
                    clearInterval(interval);
                    if (initializing) {
                        setInitializing(false);
                        toast("Firebase Timeout. Aplikasi berjalan dalam mode sandbox lokal.");
                    }
                }, 5000);

                return () => {
                    clearInterval(interval);
                    clearTimeout(fallbackTimeout);
                };
            }, [initializing]);

            const handleLogout = async () => {
                setUser(null); 
                if (window.FBApi) {
                    const { auth, signOut } = window.FBApi;
                    await signOut(auth);
                }
                toast("Anda telah keluar dari sesi logistik.");
            };

            if (initializing) {
                return (
                    <div className="min-h-screen bg-slate-950 flex flex-col items-center justify-center p-6">
                        <div className="relative flex flex-col items-center">
                            <div className="w-16 h-16 border-4 border-brand-500 border-t-transparent rounded-full animate-spin"></div>
                            <img src="MASTER PNG LOGO WHOOSH EXPRESS .png" alt="Whoosh" className="absolute w-8 h-8 top-4 object-contain" onError={(e)=>{e.target.style.display='none';}} />
                        </div>
                        <h3 className="text-white text-sm font-semibold tracking-wider uppercase mt-6 animate-pulse">Menghubungkan ke Cloud Server...</h3>
                    </div>
                );
            }

            return user ? (
                <AppLayout user={user} onLogout={handleLogout} />
            ) : (
                <AuthScreen onLoginSuccess={(loggedInUser) => setUser(loggedInUser)} />
            );
        };

        const App = () => (
            <UIProvider>
                <MainAppContainer />
            </UIProvider>
        );

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
<script src="proposal-builder.js"></script>
</body>
</html>
