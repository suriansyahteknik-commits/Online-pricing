            const loadData = useCallback(async (showNotification = false) => {
                // Local administrator uses the browser workspace as the source of truth.
                if (!user || !window.FBApi || String(user.uid || '').includes('LOCAL')) return;
                setIsSyncing(true);
                const { db, appId, collection, getDocs, doc, getDoc, setDoc } = window.FBApi;
                if (!db) {
                    setIsSyncing(false);
                    return;
                }

                try {
                    // 1. Regions Seeding / Loading
                    const regionsRef = collection(db, 'artifacts', appId, 'public', 'data', 'regions');
                    const regionsSnap = await getDocs(regionsRef);
                    if (regionsSnap.empty) {
                        for (const item of initialRegions) {
                            await setDoc(doc(db, 'artifacts', appId, 'public', 'data', 'regions', item.id), item);
                        }
                        setRegions(initialRegions);
                    } else {
                        const items = [];
                        regionsSnap.forEach(doc => items.push(doc.data()));
                        setRegions(items);
                    }

                    // 2. Routes Seeding / Loading
                    const routesRef = collection(db, 'artifacts', appId, 'public', 'data', 'routes');
                    const routesSnap = await getDocs(routesRef);
                    if (routesSnap.empty) {
                        for (const item of initialRoutes) {
                            await setDoc(doc(db, 'artifacts', appId, 'public', 'data', 'routes', item.id), item);
                        }
                        setRoutes(initialRoutes);
                    } else {
                        const items = [];
                        routesSnap.forEach(doc => items.push(doc.data()));
                        setRoutes(items);
                    }

                    // 3. Fleets Seeding / Loading
                    const fleetsRef = collection(db, 'artifacts', appId, 'public', 'data', 'fleets');
                    const fleetsSnap = await getDocs(fleetsRef);
                    if (fleetsSnap.empty) {
                        for (const item of initialFleets) {
                            await setDoc(doc(db, 'artifacts', appId, 'public', 'data', 'fleets', item.id), item);
                        }
                        setFleets(initialFleets);
                    } else {
                        const items = [];
                        fleetsSnap.forEach(doc => items.push(doc.data()));
                        setFleets(items);
                    }

                    // 4. Customers Seeding / Loading
                    const customersRef = collection(db, 'artifacts', appId, 'public', 'data', 'customers');
                    const customersSnap = await getDocs(customersRef);
                    if (customersSnap.empty) {
                        for (const item of initialCustomers) {
                            await setDoc(doc(db, 'artifacts', appId, 'public', 'data', 'customers', item.id), item);
                        }
                        setCustomers(initialCustomers);
                    } else {
                        const items = [];
                        customersSnap.forEach(doc => items.push(doc.data()));
                        setCustomers(items);
                    }

                    // 5. Quotations Seeding / Loading
                    const quotationsRef = collection(db, 'artifacts', appId, 'public', 'data', 'quotations');
                    const quotationsSnap = await getDocs(quotationsRef);
                    if (quotationsSnap.empty) {
                        for (const item of initialQuotations) {
                            await setDoc(doc(db, 'artifacts', appId, 'public', 'data', 'quotations', item.id), item);
                        }
                        setQuotations(initialQuotations);
                    } else {
                        const items = [];
                        quotationsSnap.forEach(doc => items.push(doc.data()));
                        setQuotations(items);
                    }

                    // 6. Activities Seeding / Loading
                    const activitiesRef = collection(db, 'artifacts', appId, 'public', 'data', 'activities');
                    const activitiesSnap = await getDocs(activitiesRef);
                    if (activitiesSnap.empty) {
                        for (const item of initialActivities) {
                            await setDoc(doc(db, 'artifacts', appId, 'public', 'data', 'activities', item.id), item);
                        }
                        setActivities(initialActivities);
                    } else {
                        const items = [];
                        activitiesSnap.forEach(doc => items.push(doc.data()));
                        setActivities(items);
                    }

                    // 7. Costs Configuration Seeding / Loading
                    const costDocRef = doc(db, 'artifacts', appId, 'public', 'data', 'costs', 'global');
                    const costSnap = await getDoc(costDocRef);
                    if (!costSnap.exists()) {
                        await setDoc(costDocRef, initialCosts);
                        setCosts(initialCosts);
                    } else {
                        setCosts(costSnap.data());
                    }

                    if (showNotification) {
                        toast("Data berhasil disinkronisasi dengan database awan.");
                    }
                } catch (err) {
                    console.error("Cloud synchronizer load failed:", err);
                    toast("Gagal memuat data awan. Berjalan dalam mode aman lokal.", "error");
                } finally {
                    setIsSyncing(false);
                }
            }, [user, toast]);

            useEffect(() => {
                loadData();
            }, [loadData]);

            const handleSaveDoc = async (collectionName, itemId, data) => {
                if (collectionName === 'regions') {
                    setRegions(prev => {
                        const idx = prev.findIndex(r => r.id === itemId);
                        if (idx >= 0) { const next = [...prev]; next[idx] = data; return next; }
                        return [...prev, data];
                    });
                } else if (collectionName === 'routes') {
                    setRoutes(prev => {
                        const idx = prev.findIndex(r => r.id === itemId);
                        if (idx >= 0) { const next = [...prev]; next[idx] = data; return next; }
                        return [...prev, data];
                    });
                } else if (collectionName === 'fleets') {
                    setFleets(prev => {
                        const idx = prev.findIndex(f => f.id === itemId);
                        if (idx >= 0) { const next = [...prev]; next[idx] = data; return next; }
                        return [...prev, data];
                    });
                } else if (collectionName === 'customers') {
                    setCustomers(prev => {
                        const idx = prev.findIndex(c => c.id === itemId);
                        if (idx >= 0) { const next = [...prev]; next[idx] = data; return next; }
                        return [...prev, data];
                    });
                } else if (collectionName === 'quotations') {
                    setQuotations(prev => {
                        const idx = prev.findIndex(q => q.id === itemId);
                        if (idx >= 0) { const next = [...prev]; next[idx] = data; return next; }
                        return [...prev, data];
                    });
                } else if (collectionName === 'activities') {
                    setActivities(prev => {
                        const idx = prev.findIndex(a => a.id === itemId);
                        if (idx >= 0) { const next = [...prev]; next[idx] = data; return next; }
                        return [...prev, data];
                    });
                }

                if (!user || !window.FBApi || String(user.uid || '').includes('LOCAL')) return;
                const { db, appId, doc, setDoc } = window.FBApi;
                if (!db) return;
                try {
                    await setDoc(doc(db, 'artifacts', appId, 'public', 'data', collectionName, itemId), data);
                } catch (e) {
                    console.error("Awan write error: ", e);
                }
            };

            const handleDeleteDoc = async (collectionName, itemId) => {
                if (collectionName === 'regions') {
                    setRegions(prev => prev.filter(r => r.id !== itemId));
                } else if (collectionName === 'routes') {
                    setRoutes(prev => prev.filter(r => r.id !== itemId));
                } else if (collectionName === 'fleets') {
                    setFleets(prev => prev.filter(f => f.id !== itemId));
                } else if (collectionName === 'customers') {
                    setCustomers(prev => prev.filter(c => c.id !== itemId));
                } else if (collectionName === 'quotations') {
                    setQuotations(prev => prev.filter(q => q.id !== itemId));
                } else if (collectionName === 'activities') {
                    setActivities(prev => prev.filter(a => a.id !== itemId));
                }

                if (!user || !window.FBApi || String(user.uid || '').includes('LOCAL')) return;
                const { db, appId, doc, deleteDoc } = window.FBApi;
                if (!db) return;
                try {
                    await deleteDoc(doc(db, 'artifacts', appId, 'public', 'data', collectionName, itemId));
                } catch (e) {
                    console.error("Awan delete error: ", e);
                }
            };

            const addQuotationWithLog = useCallback((q) => {
                const newId = generateId('QTN');
                const finalQ = { ...q, id: newId };
                handleSaveDoc('quotations', newId, finalQ);

                const actId = generateId('ACT');
                const newAct = {
                    id: actId,
                    timestamp: new Date().toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }),
                    date: new Date().toISOString().split('T')[0],
                    message: `Quotation baru dibuat untuk Klien "${q.client}" (${q.route})`,
                    type: 'create',
                    user: user.email || 'Admin'
                };
                handleSaveDoc('activities', actId, newAct);
            }, [user]);

            useEffect(() => {
                if (theme === 'dark') document.documentElement.classList.add('dark');
                else document.documentElement.classList.remove('dark');
            }, [theme]);

            useEffect(() => {
                const handleResize = () => {
                    if (window.innerWidth < 1024) setIsSidebarOpen(false);
                    else setIsSidebarOpen(true);
                };
                window.addEventListener('resize', handleResize);
                handleResize();
                return () => window.removeEventListener('resize', handleResize);
            }, []);

            const menuGroups = [
                {
                    title: "Menu Utama",
                    items: [
                        { id: 'dashboard', label: 'Dashboard Analytics', icon: 'fa-chart-pie' },
                        { id: 'master_harga', label: 'Master Tarif Acuan', icon: 'fa-tags' },
                        { id: 'master_tarif_driver', label: 'Tarif Mitra Driver', icon: 'fa-id-card' }, 
                        { id: 'simulasi', label: 'Kalkulator HPP', icon: 'fa-calculator' },
                        { id: 'penawaran', label: 'Arsip Penawaran', icon: 'fa-file-invoice-dollar' },
                    ]
                },
                {
                    title: "Klien & Master Data",
                    items: [
                        { id: 'customer', label: 'Daftar Klien', icon: 'fa-users' },
                        { id: 'wilayah', label: 'Master Wilayah', icon: 'fa-map-location-dot' },
                        { id: 'rute', label: 'Master Rute', icon: 'fa-route' },
                        { id: 'armada', label: 'Master Armada', icon: 'fa-truck-moving' },
                        { id: 'biaya', label: 'Konfigurasi Biaya', icon: 'fa-money-bill-transfer' },
                    ]
                }
            ];

            const renderContent = () => {
                switch (currentView) {
                    case 'dashboard':
                        return <DashboardBI 
                            theme={theme} 
                            quotations={quotations} 
                            routes={routes} 
                            fleets={fleets} 
                            regions={regions} 
                            customers={customers} 
                            activities={activities} 
