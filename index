                    case 'wilayah':
                        return <MasterCrudView title="Master Wilayah" description="Kelola titik pool, cabang, dan zona operasional." icon="fa-map-location-dot" data={regions} 
                            onSave={(item, isEdit) => {
                                const id = isEdit ? item.id : generateId('REG');
                                handleSaveDoc('regions', id, { ...item, id });
                            }} 
                            onDelete={(id) => handleDeleteDoc('regions', id)}
                            columns={[ {label: 'ID', key: 'id'}, {label: 'Provinsi', key: 'province'}, {label: 'Kota/Kab', key: 'city'}, {label: 'Tipe', key: 'type', format: v => <span className={`px-2 py-1 rounded text-xs font-semibold ${v==='Pool'?'bg-blue-100 text-blue-800 dark:bg-blue-900/30':v==='Cabang'?'bg-purple-100 text-purple-800 dark:bg-purple-900/30':'bg-orange-100 text-orange-800 dark:bg-orange-900/30'}`}>{v}</span>} ]}
                            fields={[ {name: 'province', label: 'Provinsi', type: 'text', required: true}, {name: 'city', label: 'Kota/Kabupaten', type: 'text', required: true}, {name: 'type', label: 'Tipe Lokasi', type: 'select', options: [{value: 'Pool', label:'Pool Utama'}, {value: 'Cabang', label:'Cabang'}, {value: 'Zona', label:'Zona Jangkauan'}], required: true} ]} />;
                    case 'rute':
                        return <MasterCrudView title="Master Rute" description="Daftar rute perjalanan beserta jarak dan biaya tol dasar." icon="fa-route" data={routes} 
                            onSave={(item, isEdit) => {
                                const id = isEdit ? item.id : generateId('RT');
                                handleSaveDoc('routes', id, { ...item, id });
                            }} 
                            onDelete={(id) => handleDeleteDoc('routes', id)}
                            columns={[ {label: 'Kota Asal', key: 'origin'}, {label: 'Kota Tujuan', key: 'dest'}, {label: 'Jarak', key: 'distanceKm', format: v=>`${v} Km`}, {label: 'Waktu Est.', key: 'timeHours', format: v=>`${v} Jam`}, {label: 'Tol Dasar', key: 'baseToll', format: formatCurrency} ]}
                            fields={[ {name: 'origin', label: 'Kota Asal', type: 'text', required: true}, {name: 'dest', label: 'Kota Tujuan', type: 'text', required: true}, {name: 'distanceKm', label: 'Jarak Fisik (KM)', type: 'number', required: true}, {name: 'timeHours', label: 'Estimasi Waktu Tempuh (Jam)', type: 'number', required: true}, {name: 'baseToll', label: 'Biaya Tol Dasar (Opsional)', type: 'number', required: false} ]} />;
                    case 'armada':
                        return <MasterCrudView title="Master Armada" description="Kelola spesifikasi kendaraan, konsumsi BBM, dan tarif dinamis." icon="fa-truck" data={fleets} 
                            onSave={(item, isEdit) => {
                                const id = isEdit ? item.id : generateId('FL');
                                handleSaveDoc('fleets', id, { ...item, id });
                            }} 
                            onDelete={(id) => handleDeleteDoc('fleets', id)}
                            columns={[ 
                                {label: 'Nama Kendaraan', key: 'name', format: v=><span className="font-semibold">{v}</span>}, 
                                {label: 'Tipe BBM', key: 'fuelType'}, 
                                {label: 'Tarif Dasar (≤ 35KM)', key: 'baseDriverFee', format: formatCurrency}, 
                                {label: 'Tarif >600KM', key: 'feeKm_600_plus', format: v => v ? formatCurrency(v) + '/Km' : '-'} 
                            ]}
                            fields={[ 
                                {name: 'name', label: 'Nama/Jenis Armada', type: 'text', required: true, fullWidth: true}, 
                                {name: 'type', label: 'Kategori Ukuran', type: 'select', options:[{value:'Small',label:'Kecil (Small)'}, {value:'Medium',label:'Sedang (Medium)'}, {value:'Large',label:'Besar (Large)'}, {value:'Special',label:'Khusus (Special)'}], required: true}, 
                                {name: 'fuelType', label: 'Jenis Bahan Bakar', type: 'select', options:[{value:'Solar',label:'Solar / Biosolar'}, {value:'Pertalite',label:'Pertalite'}, {value:'Pertamax',label:'Pertamax'}], required: true}, 
                                {name: 'fuelRatio', label: 'Rasio Konsumsi (KM per 1 Liter)', type: 'number', required: true}, 
                                {name: 'baseDriverFee', label: 'Tarif Dalam Kota (Radius ≤ 35 KM)', type: 'number', required: true}, 
                                {name: 'feeKm_25_50', label: 'Tarif/KM (36 - 50 KM)', type: 'number', required: true}, 
                                {name: 'feeKm_50_100', label: 'Tarif/KM (51 - 100 KM)', type: 'number', required: true},
                                {name: 'feeKm_100_150', label: 'Tarif/KM (101 - 150 KM)', type: 'number', required: true},
                                {name: 'feeKm_150_200', label: 'Tarif/KM (151 - 200 KM)', type: 'number', required: true},
                                {name: 'feeKm_200_250', label: 'Tarif/KM (201 - 250 KM)', type: 'number', required: true},
                                {name: 'feeKm_250_300', label: 'Tarif/KM (251 - 300 KM)', type: 'number', required: true},
                                {name: 'feeKm_300_350', label: 'Tarif/KM (301 - 350 KM)', type: 'number', required: true},
                                {name: 'feeKm_350_400', label: 'Tarif/KM (351 - 400 KM)', type: 'number', required: true},
                                {name: 'feeKm_400_450', label: 'Tarif/KM (401 - 450 KM)', type: 'number', required: true},
                                {name: 'feeKm_450_550', label: 'Tarif/KM (451 - 550 KM)', type: 'number', required: true},
                                {name: 'feeKm_550_600', label: 'Tarif/KM (551 - 600 KM)', type: 'number', required: true},
                                {name: 'feeKm_600_plus', label: 'Tarif/KM (> 600 KM)', type: 'number', required: true}
                            ]} />;
                    case 'biaya':
                        return <MasterBiayaView costs={costs} onSave={async (updated) => {
                            setCosts(updated);
                            if (!user || !window.FBApi) return;
                            const { db, appId, doc, setDoc } = window.FBApi;
