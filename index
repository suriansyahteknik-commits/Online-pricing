                                console.error("Awan save costs failed: ", e);
                            }
                        }} />;
                    default:
                        return <div>Halaman tidak ditemukan.</div>;
                }
            };

            return (
                <div className="flex h-screen bg-slate-100 dark:bg-slate-950 overflow-hidden font-sans">
                    {!isSidebarOpen && window.innerWidth < 1024 && (
                        <div className="fixed inset-0 bg-black/50 z-20 lg:hidden" onClick={() => setIsSidebarOpen(true)}></div>
                    )}

                    <aside className={`fixed lg:static inset-y-0 left-0 z-30 transform ${isSidebarOpen ? 'translate-x-0 w-72' : '-translate-x-full lg:translate-x-0 lg:w-20'} flex flex-col bg-slate-900 text-white transition-all duration-300 ease-in-out shrink-0 no-print`}>
                        <div className="h-16 flex items-center justify-between px-4 sm:px-6 bg-slate-950/50">
                            <div className="flex items-center cursor-pointer group relative overflow-hidden rounded-lg w-full h-12" onClick={() => fileInputRef.current.click()} title="Klik untuk Ganti Logo Manual">
                                <img src={logoUrl} alt="WHOOSH EXPRESS" className={`h-10 w-auto max-w-[180px] object-contain transition-all ${!isSidebarOpen && 'lg:mx-auto lg:h-8'}`} onError={(e)=>{e.target.src='https://placehold.co/180x60/f97316/ffffff?text=WHOOSH';}} />
                                <div className="absolute inset-0 bg-black/80 hidden group-hover:flex items-center justify-center text-[9px] font-semibold tracking-wider text-slate-300 transition-all opacity-0 group-hover:opacity-100">
                                    <i className="fa-solid fa-cloud-arrow-up mr-1"></i> UBAH LOGO
                                </div>
                                <input type="file" accept="image/png, image/jpeg" ref={fileInputRef} onChange={handleLogoUpload} className="hidden" />
